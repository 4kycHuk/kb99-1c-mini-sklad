
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	// Проверяем достаточность остатков при любом режиме проведения.
	ПроверитьДостаточностьОстатков(Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Формируем расходные движения для строк документа.
	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого СтрокаТоваровДокумента Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = СтрокаТоваровДокумента.Товар;
		Движение.Количество = СтрокаТоваровДокумента.Количество;
		Движение.Сумма = СтрокаТоваровДокумента.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедуры

Процедура ПроверитьДостаточностьОстатков(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	РеализацияТовары.КоличествоКСписанию КАК КоличествоКСписанию,
	|	ЕСТЬNULL(ОстаткиТоваров.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыДокумента.Товар КАК Товар,
	|		СУММА(ТоварыДокумента.Количество) КАК КоличествоКСписанию
	|	ИЗ
	|		Документ.Реализация.Товары КАК ТоварыДокумента
	|	ГДЕ
	|		ТоварыДокумента.Ссылка = &Ссылка
	|	СГРУППИРОВАТЬ ПО
	|		ТоварыДокумента.Товар) КАК РеализацияТовары
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ
	|			РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Товар В
	|					(ВЫБРАТЬ
	|						ТоварыДокумента.Товар
	|					ИЗ
	|						Документ.Реализация.Товары КАК ТоварыДокумента
	|					ГДЕ
	|						ТоварыДокумента.Ссылка = &Ссылка)
	|			) КАК ОстаткиТоваров
	|		ПО РеализацияТовары.Товар = ОстаткиТоваров.Товар
	|ГДЕ
	|	ЕСТЬNULL(ОстаткиТоваров.КоличествоОстаток, 0) < РеализацияТовары.КоличествоКСписанию";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());

	РезультатПроверкиОстатков = Запрос.Выполнить();
	ВыборкаНедостающихОстатков = РезультатПроверкиОстатков.Выбрать();

	Пока ВыборкаНедостающихОстатков.Следующий() Цикл
		Сообщить(
			СтрШаблон(
				"Недостаточно товара ""%1"". Доступный остаток: %2. Требуется: %3.",
				Строка(ВыборкаНедостающихОстатков.Товар),
				Формат(ВыборкаНедостающихОстатков.Остаток, "ЧГ=0"),
				Формат(ВыборкаНедостающихОстатков.КоличествоКСписанию, "ЧГ=0")
			)
		);
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
