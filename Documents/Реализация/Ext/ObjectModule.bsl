
Процедура ОбработкаПроведения(Отказ, Режим)

	Если Режим = РежимПроведенияДокумента.Оперативный Тогда
		ПроверитьДостаточностьОстатков(Отказ);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Формируем расходные движения для строк документа.
	Движения.ОстаткиТоваров.Записывать = Истина;

	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Сумма = ТекСтрокаТовары.Сумма;
	КонецЦикла;

КонецПроцедуры


Процедура ПроверитьДостаточностьОстатков(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	РеализацияТовары.КоличествоКСписанию КАК КоличествоКСписанию,
	|	ЕСТЬNULL(ОстаткиТоваров.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыДокумента.Товар КАК Товар,
	|		СУММА(ТоварыДокумента.Количество) КАК КоличествоКСписанию
	|	ИЗ
	|		Документ.Реализация.Товары КАК ТоварыДокумента
	|	ГДЕ
	|		ТоварыДокумента.Ссылка = &Ссылка
	|
	|	СГРУППИРОВАТЬ ПО
	|		ТоварыДокумента.Товар) КАК РеализацияТовары
	|
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|			&МоментВремени,
	|			Товар В
	|				(ВЫБРАТЬ
	|					ТоварыДокумента.Товар
	|				ИЗ
	|					Документ.Реализация.Товары КАК ТоварыДокумента
	|				ГДЕ
	|					ТоварыДокумента.Ссылка = &Ссылка)) КАК ОстаткиТоваров
	|		ПО РеализацияТовары.Товар = ОстаткиТоваров.Товар
	|ГДЕ
	|	ЕСТЬNULL(ОстаткиТоваров.КоличествоОстаток, 0) < РеализацияТовары.КоличествоКСписанию";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		Сообщить(
		СтрШаблон(
		"Недостаточно товара ""%1"". Доступный остаток: %2. Требуется: %3.",
		Строка(Выборка.Товар),
		Формат(Выборка.Остаток, "ЧГ=0"),
		Формат(Выборка.КоличествоКСписанию, "ЧГ=0")
		)
		);
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры
